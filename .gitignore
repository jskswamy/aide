
# Dolt database files (added by bd init)
.dolt/
*.db
.beads/
.claude/
!.claude/commands/

# Project config (user-specific)
.aide.yaml

# Git worktrees
.worktrees/

# nix-direnv cache (https://github.com/nix-community/nix-direnv)
.direnv/

# Go build output and devshell tool binaries
bin/
.gobin/
/aide
*.exe

# goreleaser output (make install routes through goreleaser build)
dist/

# Plugin state
.entire/

# Refactor scanner working dir (agent artifact)
.refactor-scan/

# IDE/editor
.idea/
.vscode/
*.swp

# Test secrets (plaintext only; encrypted .enc.yaml is safe to commit)
testdata/test-secrets.yaml

# Golden test failure artifacts (written by tests on mismatch, not for commit)
testdata/*.actual.*

coverage.out
CLAUDE.md
